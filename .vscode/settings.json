{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/obj": true,
        "packages": true
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "README.md": "LICENSE, *.md, .gitignore, *.json",
        "*.ps1": "$(capture)-*.ps1",
        "*.sln": "*.suo, *.user",
        "*.csproj": "*.config, *.xml, *.xsd, .gitignore, .gitattributes",
        "*.cs": "$(capture).Designer.cs, $(capture).resx",
        "*.settings": "$(capture).Designer.cs",
        "*.resx": "$(capture).Designer.cs",
        "catalog.json": "nuget.config",
        "scripts/*": ""
    }
}